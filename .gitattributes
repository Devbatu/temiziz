# Metin dosyalarını normalize et.
* text=auto eol=lf

# Sunucuya yüklenen dosyalar her zaman LF olmalı: CRLF taşıyan bir kabuk
# betiği Linux'ta "bad interpreter" hatasıyla çalışmaz, CRLF'li PHP dosyası
# da header() öncesi çıktı üretmiş sayılabilir.
*.sh   text eol=lf
*.php  text eol=lf
*.sql  text eol=lf

# İkili dosyalar dokunulmadan saklanır.
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.gz   binary
*.zip  binary
