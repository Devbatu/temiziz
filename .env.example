# ─────────────────────────── Site ───────────────────────────
# Üretim alan adı — canonical, OpenGraph ve sitemap URL'lerini besler.
NEXT_PUBLIC_SITE_URL=https://celaning.com

# ─────────────────────── Sunucu tarafı sırlar ───────────────────────
# Derlemeye girmez, yalnızca çalışma anında okunur.

# Yapay zekâ araçları (AI kategorisindeki 10 araç) için gereklidir.
# Anahtar: https://platform.claude.com
ANTHROPIC_API_KEY=

# Site Ekran Görüntüsü aracı için isteğe bağlı sağlayıcı adresi.
# {url}, {width} ve {height} yer tutucuları çalışma anında doldurulur.
SCREENSHOT_API_URL=

# ads.txt dosyasına eklenecek ek satırlar (her satıra bir satıcı).
ADS_TXT_EXTRA=

# ─────────────────────────── Reklam ───────────────────────────
# NEXT_PUBLIC_* değerleri DERLEME ANINDA paketlenir.
# Değiştirdikten sonra yeniden derlemeniz gerekir.

# AdSense yayıncı kimliği. Boş bırakılırsa reklam alanları yerine
# Premium tanıtımı gösterilir — düzen bozulmaz.
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense panelinden aldığınız reklam birimi kimlikleri (yalnızca rakam).
NEXT_PUBLIC_AD_HOME_MID=
NEXT_PUBLIC_AD_HOME_BOTTOM=
NEXT_PUBLIC_AD_TOOLS_GRID=
NEXT_PUBLIC_AD_TOOL_BELOW=
NEXT_PUBLIC_AD_TOOL_SIDEBAR=
NEXT_PUBLIC_AD_CATEGORY_TOP=
NEXT_PUBLIC_AD_BLOG_INARTICLE=
NEXT_PUBLIC_AD_BLOG_LIST=

# ─────────────────────── Analitik / Admin ───────────────────────
# PHP toplayicinin adresi. Bos birakilirsa izleme tamamen kapali kalir.
NEXT_PUBLIC_ANALYTICS_URL=https://celaning.com/mt/collect.php

# ─────────────────── Search Console ───────────────────
# Google Search Console > Mulk ekle > HTML etiketi yontemi.
# content="..." icindeki degeri buraya yapistirin.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Tek reklam birimi kimligi: kendi kimligi verilmeyen tum yerlesimler
# bunu kullanir. AdSense > Reklamlar > Reklam birimine gore > Goruntulu reklam
NEXT_PUBLIC_AD_DEFAULT=
